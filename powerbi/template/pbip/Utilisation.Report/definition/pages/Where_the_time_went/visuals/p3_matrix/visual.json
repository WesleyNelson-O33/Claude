            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Job"
                    }
                  },
                  "Property": "Job Group"
                }
              },
              "queryRef": "Dim_Job.Job Group",
              "nativeQueryRef": "Job Group"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
