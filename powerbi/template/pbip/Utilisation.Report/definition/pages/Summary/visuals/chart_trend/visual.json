{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "chart_trend",
  "position": {
    "x": 40,
    "y": 300,
    "z": 0,
    "width": 1120,
    "height": 380,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "Week Ending"
                }
              },
              "queryRef": "Dim_Date.Week Ending",
              "nativeQueryRef": "Week Ending"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Utilisation % R13W"
                }
              },
              "queryRef": "_Measures.Utilisation % R13W",
              "nativeQueryRef": "Utilisation % R13W"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Target Utilisation %"
                }
              },
              "queryRef": "_Measures.Target Utilisation %",
              "nativeQueryRef": "Target Utilisation %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Utilisation trend'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Rolling 13 weeks - a single fortnight is too noisy to read'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
